# =====================================================================
# REVORA — Variables d'environnement (exemple)
# Copier ce fichier en `.env.local` et renseigner les vraies valeurs.
# Ne JAMAIS committer `.env.local` (il est ignoré par git).
# Les variables NEXT_PUBLIC_* sont exposées au navigateur : n'y mettre
# aucun secret.
# =====================================================================

# --- Application ---
# URL publique du site (sans slash final). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (base de données, auth, storage — région UE) ---
# Tableau de bord Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # clé "anon public"
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # clé "service_role" — SECRET, serveur/Railway uniquement

# --- Stripe (paiements : acomptes, abonnements) ---
STRIPE_SECRET_KEY=sk_test_...                   # SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                 # signature des webhooks Stripe

# --- Brevo (e-mails transactionnels) ---
BREVO_API_KEY=xkeysib-...                       # SECRET
BREVO_EXPEDITEUR_EMAIL=contact@revora.fr        # e-mail d'envoi (SPF/DKIM configurés)
BREVO_EXPEDITEUR_NOM=Revora

# --- Twilio (SMS / WhatsApp — rappels et anti no-show) ---
TWILIO_ACCOUNT_SID=AC...                        # SECRET
TWILIO_AUTH_TOKEN=...                           # SECRET
TWILIO_SMS_SENDER=REVORA                        # expéditeur SMS (déclaré au registre AF2M)
TWILIO_WHATSAPP_FROM=whatsapp:+33...            # numéro WhatsApp Business (V1.1)

# --- Cloudinary (visuels NON sensibles uniquement) ---
# Les photos clientes sensibles vont dans Supabase Storage (UE), pas ici.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=xxxx
CLOUDINARY_API_KEY=...                          # SECRET
CLOUDINARY_API_SECRET=...                       # SECRET

# --- Google (OAuth de connexion + configuration via Google Cloud Console) ---
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...                        # SECRET

# --- Railway (tâches de fond : cron des rappels, webhooks — région UE) ---
# Secret partagé pour authentifier les appels entre le worker Railway et l'API.
RAILWAY_CRON_SECRET=...                          # SECRET
